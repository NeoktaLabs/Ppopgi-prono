{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppopgi-prono",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppopgi-prono",
      "database_id": "d5a431b0-0777-47e9-9f4f-47cbfde4f6ac",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "tech@ppopgi.xyz"
    }
  ],
  "triggers": {
    "crons": ["0 5 * * *", "*/15 * * * *"]
  },
  "vars": {
    "APP_NAME": "Ppopgi Predictions",
    "APP_URL": "https://predict.ppopgi.xyz",
    "SESSION_DAYS": "90",
    "MAGIC_LINK_MINUTES": "15",
    "LEAGUE_CODE_LENGTH": "6",
    "FOOTBALL_PROVIDER": "api-football",
    "FOOTBALL_API_BASE_URL": "https://v3.football.api-sports.io",
    "FOOTBALL_API_LEAGUE_ID": "1",
    "FOOTBALL_API_SEASON": "2026",
    "GLOBAL_ADMIN_EMAILS": "tech@ppopgi.xyz",
    "EMAIL_FROM": "Ppopgi Auth <auth@ppopgi.xyz>",
    "EMAIL_REPLY_TO": "tech@ppopgi.xyz",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADXGbNGDwM2GQXFb"
  }
}
